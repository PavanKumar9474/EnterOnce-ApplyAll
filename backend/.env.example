# ApplyOnce Backend Environment Configuration
PROJECT_NAME="ApplyOnce Universal Career Autofill"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace_this_with_a_super_secret_high_entropy_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for immediate local testing if PostgreSQL/Supabase is not active
DATABASE_URL="sqlite:///./applyonce.db"
# For Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Or Supabase Transaction Pooler (port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# Optional AI Resume Parser Key (Leave empty to use deterministic PyMuPDF fallback parser)
OPENAI_API_KEY=""

# N8N Automation Webhooks
N8N_WEBHOOK_URL="http://localhost:5678/webhook/applyonce-events"
N8N_WEBHOOK_SECRET="replace_with_shared_n8n_secret_token"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*"]
