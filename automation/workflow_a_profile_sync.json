{
  "name": "ApplyOnce — Workflow A: Profile Sync Event",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "applyonce-profile-updated",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "id": "webhook-profile",
      "name": "Webhook: Profile Updated",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "applyonce-profile-updated"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-applyonce-secret'] }}",
              "rightValue": "={{ $env.APPLYONCE_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "PROFILE_UPDATED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validate-profile",
      "name": "Validate Secret & Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst data = body.data || {};\n\nif (!data.user_id || !data.profile_id) {\n  throw new Error('Missing required fields: user_id or profile_id');\n}\n\nreturn [{\n  json: {\n    event: body.event,\n    timestamp: body.timestamp,\n    user_id: data.user_id,\n    profile_id: data.profile_id,\n    verification_status: data.verification_status || 'unknown',\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "process-profile",
      "name": "Extract Metadata (No Personal Data)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"accepted\", \"event\": \"PROFILE_UPDATED\" }"
      },
      "id": "respond-ok",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 401,
        "responseBody": "={ \"error\": \"Unauthorized or invalid event type\" }"
      },
      "id": "respond-unauthorized",
      "name": "Respond 401 Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 420]
    }
  ],
  "connections": {
    "Webhook: Profile Updated": {
      "main": [[{ "node": "Validate Secret & Event", "type": "main", "index": 0 }]]
    },
    "Validate Secret & Event": {
      "main": [
        [{ "node": "Extract Metadata (No Personal Data)", "type": "main", "index": 0 }],
        [{ "node": "Respond 401 Unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "Extract Metadata (No Personal Data)": {
      "main": [[{ "node": "Respond 200 OK", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "applyonce" }]
}
